---
// Every page: <head> (SEO, social cards, structured data, fonts, theme), header, footer, consent + analytics.
import "../styles/global.css";
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import Assistant from "../components/Assistant.astro";
import NextHeader from "../components/next/NextHeader.astro";
import Dock from "../components/next/Dock.astro";
import Rail from "../components/next/Rail.astro";
import Panels from "../components/next/Panels.astro";
import VideoPlayer from "../components/next/VideoPlayer.astro";
import nextCssRaw from "../styles/next.css?raw";
// NLMC theme fonts, preloaded so text doesn't jump when they arrive (the main cause of layout shift on these pages).
import bricolageUrl from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import hankenUrl from "@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url";
import { isNext, comfortOn, type VideoInfo } from "../lib/next";
import { site, settings, isStaging, absolute, media } from "../lib/content";
import { imageFile, assetUrl } from "../lib/images";

interface Props {
  title: string; description?: string; path: string; image?: string; type?: string; noindex?: boolean;
  schema?: object | object[] | null; published?: string; modified?: string; dark?: boolean; kind?: string; video?: VideoInfo | null;
}
const { title, description = "", path, image, type = "website", noindex = false, schema, published, modified, kind = "", video = null } = Astro.props;
// New layout: its stylesheet is inlined only on sites that use it (comments and extra spaces stripped).
const nextCss = isNext ? nextCssRaw.replace(/\/\*[\s\S]*?\*\//g, "").replace(/\s*\n\s*/g, "").replace(/\s{2,}/g, " ") : "";

const themes = import.meta.glob("../styles/themes/*.css", { eager: true });
void themes;   // all themes are bundled; the one in use is picked by the data-theme class below
const theme = site.theme || "nlmc";

let ogUrl = "";
const ogMedia = media(image || settings.seo?.default_og_image);
const ogImg = imageFile(ogMedia?.file);
if (ogImg) { const o = await getImage({ src: ogImg, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 82 }); ogUrl = absolute(o.src); }
else if (ogMedia) { const u = assetUrl(ogMedia.file); if (u && !u.endsWith(".svg")) ogUrl = absolute(u); }

const icon = media(settings.brand?.icon);
const iconImg = imageFile(icon?.file);
const icon32 = iconImg ? (await getImage({ src: iconImg, width: 32, height: 32, format: "png" })).src : assetUrl(icon?.file);
const icon180 = iconImg ? (await getImage({ src: iconImg, width: 180, height: 180, format: "png" })).src : undefined;

const c = settings.brand?.colors || {};
const brandVars = Object.entries({ "--accent": c.accent, "--accent-hover": c.accent_hover, "--accent-text": c.accent, "--brand-band": c.band || c.accent, "--dark": c.dark, "--heading": c.heading, "--link": c.link })
  .filter(([, v]) => typeof v === "string" && /^#[0-9a-f]{3,8}$/i.test(v)).map(([k, v]) => `${k}:${v}`).join(";");

const canonical = absolute(path);
const robots = isStaging ? "noindex, nofollow" : noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
const siteName = settings.org?.name || site.name;
const schemas = (Array.isArray(schema) ? schema : schema ? [schema] : []).filter(Boolean);
const lang = settings.locale || "en-US";
---
<!doctype html>
<html lang={lang} class={`theme-${theme}${isNext ? " layout-next" : ""}`}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={robots} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  {ogUrl && <meta property="og:image" content={ogUrl} />}
  {ogUrl && <meta property="og:image:width" content="1200" />}
  {ogUrl && <meta property="og:image:height" content="630" />}
  {published && <meta property="article:published_time" content={published} />}
  {modified && <meta property="article:modified_time" content={modified} />}
  <meta name="twitter:card" content={ogUrl ? "summary_large_image" : "summary"} />
  {settings.org?.twitter && <meta name="twitter:site" content={settings.org.twitter} />}
  {icon32 && <link rel="icon" href={icon32} sizes="32x32" />}
  {icon180 && <link rel="apple-touch-icon" href={icon180} />}
  {c.dark && <meta name="theme-color" content={c.dark} />}
  <link rel="alternate" type="application/rss+xml" title={`${siteName} — Insights`} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap.xml" />
  {theme === "nlmc" && [bricolageUrl, hankenUrl].map((u) => <link rel="preload" href={u} as="font" type="font/woff2" crossorigin />)}
  {isNext && <style is:inline set:html={nextCss} />}
  {isNext && comfortOn && <script is:inline>try{var c=JSON.parse(localStorage.getItem("comfort.v1")||"{}"),h=document.documentElement;if(c.size)h.dataset.size=c.size;if(c.contrast==="1")h.classList.add("c-hc");if(c.motion==="1")h.classList.add("c-rm");if(c.font==="1")h.classList.add("c-rf")}catch(e){}</script>}
  {brandVars && <style is:inline set:html={`html.theme-${theme}{${brandVars}}`} />}
  {schemas.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s).replace(/</g, "\\u003c")} />)}
  {!isStaging && settings.seo?.google_verification && <meta name="google-site-verification" content={settings.seo.google_verification} />}
  {!isStaging && settings.seo?.bing_verification && <meta name="msvalidate.01" content={settings.seo.bing_verification} />}
  {settings.forms?.turnstile_site_key && <link rel="preconnect" href="https://challenges.cloudflare.com" />}
  <Analytics path={path} kind={kind} />
  <script type="speculationrules" is:inline set:html={JSON.stringify({ prefetch: [{ source: "document", where: { and: [{ href_matches: "/*" }, { not: { selector_matches: "[rel~=nofollow],[target=_blank]" } }] }, eagerness: "moderate" }] })} />
</head>
<body>
  <Analytics part="body_start" path={path} kind={kind} />
  <a class="skip" href="#main">Skip to content</a>
  {isStaging && <div class="staging-flag" aria-hidden="true">Staging</div>}
  {isNext ? (
    <>
      <NextHeader path={path} />
      <div class="nx-shell">
        <Rail side="left" path={path} />
        <main id="main"><slot /></main>
        <Rail side="right" path={path} video={video} />
      </div>
      <Footer />
      <Dock path={path} />
      <Panels />
      {video && <VideoPlayer video={video} />}
    </>
  ) : (
    <>
      <Header path={path} />
      <main id="main"><slot /></main>
      <Footer />
    </>
  )}
  <Assistant path={path} />
  <Analytics part="body" path={path} kind={kind} />
</body>
</html>

<style>
  .staging-flag { position: fixed; z-index: 60; bottom: 12px; left: 12px; background: #f59e0b; color: #111; font: 700 11px/1 var(--font-body); letter-spacing: .1em; text-transform: uppercase; padding: 6px 9px; border-radius: 3px; pointer-events: none; }
</style>
