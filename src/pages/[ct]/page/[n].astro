---
// Pages 2, 3… of a custom content type's listing page (/<route>/page/<n>/). See components/TypeListing.astro.
import TypeListing from "../../../components/TypeListing.astro";
import { livePaths, liveProps } from "../../../lib/live";
import { typePagePaths } from "../../../lib/paths";
import type { ContentType } from "../../../lib/content";

export function getStaticPaths() {
  return livePaths(typePagePaths);
}
const props = liveProps(typePagePaths, Astro.params, Astro.props);   // the website being shown (editor's Live view; lib/live.ts)
if (!props) return new Response("This page isn't on this website (yet).", { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
const { ct, page } = props as { ct: ContentType; page: number };
---
<TypeListing ct={ct} page={page} />
