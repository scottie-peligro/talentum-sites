---
// A custom content type's own listing page at its address (e.g. /events/), when "Listing page" is on and no page
// of the site already lives there. Pages 2, 3… are pages/[ct]/page/[n].astro. Rendering: components/TypeListing.astro.
import TypeListing from "../components/TypeListing.astro";
import { listedTypes } from "../lib/listing";
import type { ContentType } from "../lib/content";

export function getStaticPaths() {
  return listedTypes().map((t) => ({ params: { ct: t.route }, props: { ct: t } }));
}
const { ct } = Astro.props as { ct: ContentType };
---
<TypeListing ct={ct} />
