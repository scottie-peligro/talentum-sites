---
// Every published entry, at its path. The template depends on the entry's type.
import Base from "../layouts/Base.astro";
import Blocks from "../components/Blocks.astro";
import PageHeader from "../components/PageHeader.astro";
import Crumbs from "../components/Crumbs.astro";
import Img from "../components/Img.astro";
import { getImage } from "astro:assets";
import {
  entries, bundle, settings, media, person, lineName, accountName, category, formatDate, rich, resolveFaqs, readingMinutes,
  proofFor, caseStudies, testimonialsFor, faqsFor, absolute, contentType, allEntries, setLang, section, t, pagedCards, cardPages, setCardsPage, type Entry, type Block,
} from "../lib/content";
import CustomFields from "../components/CustomFields.astro";
import { imageFile } from "../lib/images";
import { pageTitle, pageDescription, ogImageId, schemaFor, faqSchema, videoSchema, visibleBlocks } from "../lib/seo";
import { overviewVideo } from "../lib/next";
import { socialCard } from "../lib/og";
import { libraryFaqs } from "../lib/faqlib";
import VideoButton from "../components/next/VideoButton.astro";

export function getStaticPaths() {
  const taken = new Set(allEntries.map((e) => e.path));
  // A Content cards block set to "Show all" with a number per page: pages 2, 3… at <page>/page/<n>/.
  const paged = allEntries.flatMap((e) => {
    const b = pagedCards(e.blocks);
    if (!b) return [];
    const n = cardPages(b.data || {}, e.id);
    // Each address keeps its own number: one that's already a page of the site is skipped (that page wins), the rest
    // don't shift down.
    return Array.from({ length: Math.max(0, n - 1) }, (_, i) => ({ p: `${e.path}page/${i + 2}/`, page: i + 2 })).filter((x) => !taken.has(x.p))
      .map((x) => ({ params: { path: x.p.replace(/^\/|\/$/g, "") }, props: { entry: e, page: x.page, pagedId: b.id } }));
  });
  return [...allEntries.map((e) => ({ params: { path: e.path === "/" ? undefined : e.path.replace(/^\/|\/$/g, "") }, props: { entry: e } })), ...paged];
}

const { entry, page = 1, pagedId = "" } = Astro.props as { entry: Entry; page?: number; pagedId?: string };
const e = entry;
setLang(e.lang);   // a translation renders in its language (links, menus, sections and built-in wording follow)
setCardsPage(page, pagedId);   // which page of a paged Content cards block this is (1 = the page itself)
const pagePath = page > 1 ? `${e.path}page/${page}/` : e.path;
const blocks = visibleBlocks(e.blocks);
const has = (t: string) => blocks.some((b) => b.type === t || (b.type === "section_ref" && (section(b.data?.key) || []).some((x) => x.type === t)));
// These blocks carry the page's main heading themselves when they come first.
const startsWithHero = ["hero", "intent_chooser", "starting_points", "faq_library", "booking"].includes(blocks[0]?.type);
const video = overviewVideo(e);
const globalCta = section("cta") ? [{ id: "gcta", type: "section_ref", data: { key: "cta" } } as Block] : [];
const ctaLink = settings.header_cta?.label ? [{ label: settings.header_cta.label, href: settings.header_cta.url }] : [];

// Service pages show their proof automatically, after the page's own blocks, unless the page already places it.
const auto: Block[] = [];
if (e.type === "service" && e.fields?.auto_proof !== false && e.service_line) {
  if (!has("results") && proofFor(e.service_line).length) auto.push({ id: "a-res", type: "results", data: { heading: t("results_heading"), background: "white" } });
  if (!has("case_study_cards") && caseStudies(e.service_line).length) auto.push({ id: "a-cs", type: "case_study_cards", data: { heading: t("related_case_studies"), background: "paper" } });
  if (!has("testimonials") && testimonialsFor(e.service_line).some((t) => t.service_lines.includes(e.service_line))) auto.push({ id: "a-t", type: "testimonials", data: {} });
  if (!has("faq") && faqsFor(e.service_line).length) auto.push({ id: "a-f", type: "faq", data: { heading: `${e.title}: ${t("common_questions")}` } });
}
if ((e.type === "service" || e.type === "case_study" || e.type === "post") && !has("cta")) auto.push(...globalCta);

// Structured data: the page graph, plus FAQPage from every FAQ block on it.
const imgMedia = media(ogImageId(e));
const imgFile = imageFile(imgMedia?.file);
// Auto social image (lib/og.ts) when the page has no image of its own: also the image in its structured data.
const card = await socialCard(e);
const schemaImage = imgFile && !card ? absolute((await getImage({ src: imgFile, width: 1200, format: "jpg" })).src) : card ? absolute(card.url) : undefined;
const faqItems = [...blocks, ...auto].flatMap((b) => b.type === "faq" ? resolveFaqs(b.data || {}, e) : b.type === "faq_library" ? libraryFaqs(b.data || {}, e) : []);
let videoThumb = video?.posterUrl || "";
const vPoster = imageFile(media(video?.poster)?.file);
if (vPoster) videoThumb = absolute((await getImage({ src: vPoster, width: 1280, format: "jpg" })).src);
const schemas = [schemaFor(e, schemaImage), faqSchema(faqItems), video ? videoSchema(video, e, videoThumb || schemaImage) : null].filter(Boolean) as object[];

const authors = (e.authors || []).map((id) => person(id)).filter(Boolean);
const client = e.fields?.client_name || accountName(e.account);
const ct = contentType(e.type);
const csStats = e.type === "case_study" ? bundle.proof.filter((p) => p.case_study === e.id && p.kind === "stat").slice(0, 4) : [];
---
<Base kind={e.type} title={page > 1 ? `${pageTitle(e)} (page ${page})` : pageTitle(e)} description={pageDescription(e)} path={pagePath} image={ogImageId(e)} type={e.type === "post" || e.type === "case_study" ? "article" : "website"}
  noindex={!!e.seo?.noindex} schema={schemas} card={card} video={video} panel={e.fields?.panel} published={e.type === "post" ? e.published_at : undefined} modified={e.type === "post" ? e.updated : undefined}>

  {e.type === "post" ? (
    <article>
      <header class="post-head">
        <div class="wrap narrow">
          <Crumbs entry={e} />
          <p class="eyebrow">{[category(e.categories[0])?.name || t("insights"), formatDate(e.published_at), `${readingMinutes(e)} ${t("min_read")}`].filter(Boolean).join(" · ")}</p>
          <h1>{e.title}</h1>
          {e.excerpt && <p class="lede">{e.excerpt}</p>}
          {video && <VideoButton video={video} transcript />}
          {authors.length > 0 && (
            <p class="byline">
              {authors[0]!.photo_file && <Img file={authors[0]!.photo_file} alt="" cover aspect="1/1" class="av" sizes="40px" widths={[40, 80]} />}
              <span>{t("by")} {authors.map((a) => a!.name).join(", ")}{authors[0]!.job_title && <small>{authors[0]!.job_title}</small>}</span>
            </p>
          )}
        </div>
        {e.featured_image && <div class="wrap feat"><Img id={e.featured_image} priority sizes="(min-width: 1200px) 1184px, 100vw" /></div>}
      </header>
      <div class="post-body"><Blocks blocks={blocks} entry={e} /></div>
      {e.tags?.length > 0 && <div class="wrap narrow tags">{e.tags.map((t) => <span>{t}</span>)}</div>}
      {authors.length > 0 && (
        <aside class="wrap narrow author">
          {authors.map((a) => (
            <div class="card ab">
              {a!.photo_file && <Img file={a!.photo_file} alt="" cover aspect="1/1" class="av lg" sizes="72px" widths={[72, 144]} />}
              <div><p class="eyebrow">{t("about_author")}</p><h2>{a!.name}</h2>{a!.job_title && <p class="muted">{a!.job_title}</p>}{a!.linkedin && <a href={a!.linkedin} rel="noopener author" target="_blank">LinkedIn</a>}</div>
            </div>
          ))}
        </aside>
      )}
      <Blocks blocks={[{ id: "rel", type: "posts_list", data: { heading: t("more_insights"), limit: 3, category: e.categories[0] || "", background: "paper" } }]} entry={e} />
      <Blocks blocks={auto} entry={e} />
    </article>
  ) : e.type === "case_study" ? (
    <>
      {startsWithHero ? null : (
        <PageHeader entry={e} eyebrow={[t("case_study"), lineName(e.service_line)].filter(Boolean).join(" · ")} text={e.excerpt}>
          {client && <p class="client">{t("client") + " "}<strong>{client}</strong></p>}
        </PageHeader>
      )}
      {csStats.length > 0 && (
        <section class="section tight bg-white">
          <ul class="wrap grid cols-4 kstats">
            {csStats.map((p) => <li class="rule-top"><p class="v">{p.change || p.value}{!p.change && p.unit}</p><p class="m">{p.metric || p.title}</p>{p.source && <p class="s">{p.source}</p>}</li>)}
          </ul>
        </section>
      )}
      {e.featured_image && !startsWithHero && <div class="wrap feat cs-feat"><Img id={e.featured_image} priority={csStats.length === 0} sizes="(min-width: 1200px) 1184px, 100vw" /></div>}
      <Blocks blocks={blocks} entry={e} />
      <Blocks blocks={[{ id: "more", type: "case_study_cards", data: { heading: t("more_case_studies"), background: "paper", auto_line: false } }]} entry={e} />
      <Blocks blocks={auto} entry={e} />
    </>
  ) : e.type === "job" ? (
    <>
      <PageHeader entry={e} eyebrow={t("careers")} text={[e.fields?.location, e.fields?.employment_type?.replace(/_/g, " ").toLowerCase()].filter(Boolean).join(" · ")}
        buttons={e.fields?.apply_url ? [{ label: t("apply_now"), href: e.fields.apply_url }] : settings.org?.email ? [{ label: t("apply_email"), href: `mailto:${settings.org.email}?subject=${encodeURIComponent("Application: " + e.title)}` }] : []} />
      {e.fields?.description && <section class="section"><div class="wrap narrow prose" set:html={rich(e.fields.description)} /></section>}
      <Blocks blocks={blocks} entry={e} />
    </>
  ) : (
    <>
      {!startsWithHero && (
        <PageHeader entry={e} eyebrow={e.type === "service" ? lineName(e.service_line) || t("services") : ct ? ct.label : undefined} text={e.excerpt}
          tone={e.type === "legal" ? "paper" : "dark"} buttons={e.type === "service" ? ctaLink : undefined} />
      )}
      {ct && ct.show_fields && <div class="wrap ct-fields"><CustomFields entry={e} ct={ct} /></div>}
      <Blocks blocks={blocks} entry={e} />
      <Blocks blocks={auto} entry={e} />
    </>
  )}
</Base>

<style>
  .post-head { padding-block: clamp(3rem, 7vw, 5rem) 0; }
  .ct-fields { margin-block: clamp(1.5rem, 3vw, 2rem) 0; }
  .post-head h1 { font-size: clamp(2.1rem, 4.6vw, 3.4rem); }
  .byline { display: flex; align-items: center; gap: .75rem; margin-top: 1.5rem; font-weight: 600; color: var(--heading); }
  .byline small { display: block; font-weight: 400; color: var(--muted); font-size: .85rem; }
  :global(.av) { width: 40px; height: 40px; border-radius: 50%; }
  :global(.av.lg) { width: 72px; height: 72px; }
  .feat { margin-top: clamp(2rem, 5vw, 3rem); }
  .feat :global(img) { width: 100%; border-radius: var(--radius); }
  .cs-feat { margin-block: 0 clamp(1rem, 3vw, 2rem); }
  .post-body :global(.section) { padding-block: clamp(1.5rem, 3.5vw, 2.5rem); }
  .post-body :global(.prose) { font-size: 1.1rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-block: 1rem 2rem; }
  .tags span { font-size: .8rem; border: 1px solid var(--line); border-radius: 999px; padding: .2rem .7rem; color: var(--muted); }
  .author { margin-bottom: clamp(3rem, 7vw, 5rem); }
  .ab { display: flex; gap: 1.25rem; align-items: center; }
  .ab h2 { font-size: 1.25rem; margin: 0; }
  .ab p { margin: .2rem 0; }
  .client { margin-top: 1.25rem; color: var(--muted); }
  .client strong { color: var(--heading); }
  .kstats { margin: 0 auto; list-style: none; padding: 0; }
  .kstats p { margin: 0; }
  .kstats .v { font: 600 clamp(2.2rem, 4.5vw, 3rem)/1 var(--font-heading); color: var(--stat); margin-bottom: .5rem; }
  .kstats .m { color: var(--heading); font-weight: 600; }
  .kstats .s { font-size: .75rem; color: var(--muted); margin-top: .3rem; }
</style>
