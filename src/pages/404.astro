---
import Base from "../layouts/Base.astro";
import { menu, ofType, setLang, t } from "../lib/content";
import { th } from "../lib/i18n";
setLang("");   // one 404 page for the whole site, in its main language
const svc = ofType("service").slice(0, 6);
const top = menu("header").slice(0, 6);
void top;
---
<Base title={t("nf_title")} path="/404/" noindex>
  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">404</p>
      <h1><Fragment set:html={th("nf_heading")} /></h1>
      <p class="lede">{t("nf_text")}</p>
      <ul class="links">
        <li><a href="/">{t("home")}</a></li>
        {svc.map((s) => <li><a href={s.path}>{s.title}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
<script is:inline>
  // Report the missing address so Talentum can list it under Website → SEO (live site only; see functions/api/nf.js).
  try { if (location.pathname !== "/404/") fetch("/api/nf", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ path: location.pathname, ref: document.referrer }), keepalive: true }); } catch (e) {}
</script>
<style>.links { padding-left: 1.2rem; } .links li + li { margin-top: .4rem; }</style>
