---
// Testimonials — one big quote beside a heading (default), or a grid. Picked, or approved ones for the service line.
import Section from "../components/Section.astro";
import Img from "../components/Img.astro";
import { bundle, testimonialsFor, type Block, type Entry, type Testimonial } from "../lib/content";
const { block, entry } = Astro.props as { block: Block; entry?: Entry };
const d = block.data || {};
const line = d.service_line || (entry?.type === "service" ? entry.service_line : "");
let list: Testimonial[] = d.items?.length ? d.items.map((id: string) => bundle.testimonials.find((t) => t.id === id)).filter(Boolean) : testimonialsFor(line);
const grid = d.layout === "grid";
list = list.slice(0, grid ? Number(d.limit) || 6 : 1);
const who = (t: Testimonial) => [t.role, t.company].filter(Boolean).join(", ");
---
{list.length > 0 && (
  <Section bg={d.background || "paper"} id={d.anchor}>
    {grid ? (
      <div class="wrap">
        {d.heading && <h2 class="head">{d.heading}</h2>}
        <ul class="grid cols-3">
          {list.map((t) => (
            <li class="card"><blockquote><p>“{t.quote}”</p><footer>{t.photo && <Img id={t.photo} cover aspect="1/1" class="face" sizes="48px" widths={[48, 96]} />}<span><b>{t.person}</b>{who(t) && <small>{who(t)}</small>}</span></footer></blockquote></li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="wrap one">
        {d.heading && <h2 class="h">{d.heading}</h2>}
        {list.map((t) => (
          <blockquote class="big"><p>“{t.quote}”</p><footer>{t.photo && <Img id={t.photo} cover aspect="1/1" class="face" sizes="48px" widths={[48, 96]} />}<span><b>{t.person}</b>{who(t) && <small>{who(t)}</small>}</span></footer></blockquote>
        ))}
      </div>
    )}
  </Section>
)}
<style>
  ul { list-style: none; margin: 0; padding: 0; }
  blockquote { margin: 0; }
  .one { display: grid; gap: 2rem; }
  @media (min-width: 900px) { .one { grid-template-columns: var(--b-cols, 4fr 8fr); } }
  .h { font-size: clamp(1.4rem, 2.4vw, 1.75rem); }
  .big p { font: 500 clamp(1.3rem, 2.4vw, 1.75rem)/1.35 var(--font-body); color: var(--heading); margin: 0 0 1.5rem; letter-spacing: -0.01em; }
  footer { display: flex; align-items: center; gap: .75rem; border-top: 1px solid var(--line); padding-top: 1rem; font-size: .92rem; }
  footer b { display: block; color: var(--heading); font-weight: 600; }
  footer small { display: block; color: var(--muted); font-size: .85rem; }
  :global(.face) { width: 48px; height: 48px; border-radius: 50%; flex-shrink: 0; }
  .card p { color: var(--heading); }
</style>
