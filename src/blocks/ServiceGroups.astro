---
// Service groups: a few cards, each with a heading, a line of text and a list of links (e.g. the four capability groups).
import Section from "../components/Section.astro";
import Heading from "../components/Heading.astro";
import Buttons from "../components/Buttons.astro";
import { href, rich, type Block } from "../lib/content";
const { block } = Astro.props as { block: Block };
const d = block.data || {};
const groups = (d.groups || []).filter((g: any) => g && g.title);
const cols = groups.length >= 4 ? "cols-4" : groups.length === 2 ? "cols-2" : "cols-3";
---
<Section bg={d.background || "paper"} id={d.anchor}>
  <div class="wrap">
    <Heading eyebrow={d.eyebrow} heading={d.heading} text={d.text} />
    <div class={`grid ${cols}`}>
      {groups.map((g: any) => (
        <article class="card group">
          <h3>{g.href ? <a href={href(g.href)}>{g.title}</a> : g.title}</h3>
          {g.text && <div class="txt" set:html={rich(g.text)} />}
          {(g.items || []).length > 0 && (
            <ul>{g.items.filter((i: any) => i && i.label).map((i: any) => <li>{i.href ? <a href={href(i.href)}>{i.label}</a> : i.label}</li>)}</ul>
          )}
        </article>
      ))}
    </div>
    <Buttons buttons={d.buttons} />
  </div>
</Section>
<style>
  .group h3 a { color: inherit; text-decoration: none; }
  .group h3 a:hover { color: var(--accent-text); }
  .txt { font-size: .95rem; color: var(--heading); }
  ul { list-style: none; margin: 1rem 0 0; padding: 0; }
  li { border-top: 1px solid var(--line); padding: .55rem 0; font-size: .85rem; color: var(--muted); }
  li a { color: var(--muted); text-decoration: none; }
  li a:hover { color: var(--accent-text); text-decoration: underline; }
</style>
