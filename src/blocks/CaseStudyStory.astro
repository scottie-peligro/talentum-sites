---
// The case study itself: Challenge → Plan → Execution → Results, each a rich-text panel. Empty parts are skipped.
import Section from "../components/Section.astro";
import { rich, type Block } from "../lib/content";
const { block } = Astro.props as { block: Block };
const d = block.data || {};
const parts = [["challenge", d.challenge_title || "The challenge"], ["plan", d.plan_title || "The plan"], ["execution", d.execution_title || "What we did"], ["results", d.results_title || "The results"]]
  .filter(([k]) => (d[k] || "").trim());
---
<Section bg={d.background} id={d.anchor}>
  <div class="wrap story">
    {parts.map(([k, title], i) => (
      <div class="part">
        <p class="eyebrow">{String(i + 1).padStart(2, "0")}</p>
        <h2>{title}</h2>
        <div class="prose" set:html={rich(d[k])} />
      </div>
    ))}
  </div>
</Section>
<style>
  .story { display: grid; gap: clamp(2.5rem, 6vw, 4.5rem); }
  .part { display: grid; gap: .5rem 3rem; border-top: 1px solid var(--line); padding-top: 2rem; }
  @container (min-width: 900px) { .part { grid-template-columns: var(--b-cols, 4fr 8fr); } .part .eyebrow, .part h2 { grid-column: 1; } .part .prose { grid-column: 2; grid-row: 1 / span 2; } }
  h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .prose { font-size: 1.05rem; }
</style>
