---
// Before and after: the "after" picture with the "before" on top, cut at a divider. Drag anywhere on the picture
// (mouse, pen or touch; vertical swipes still scroll the page) or use the arrow keys on the slider (a real
// <input type="range">, so screen readers announce it). Without JavaScript the two pictures sit side by side.
import Section from "../../components/Section.astro";
import Heading from "../../components/Heading.astro";
import Img from "../../components/Img.astro";
import { media, type Block } from "../../lib/content";
import { once, uid } from "./util";
const { block } = Astro.props as { block: Block };
const d = block.data || {};
const before = d.before && media(d.before) ? d.before : "";
const after = d.after && media(d.after) ? d.after : "";
const ok = !!(before && after);
const id = uid(Astro.locals, "ixb");
const start = Math.min(100, Math.max(0, d.start === "" || d.start == null || isNaN(Number(d.start)) ? 50 : Number(d.start)));
const ma = media(after);
const ratio = ma?.width && ma?.height ? `${ma.width}/${ma.height}` : "3/2";
const bl = d.before_label || "Before", al = d.after_label || "After";
const first = ok && once(Astro.locals, "before_after");
const JS = `document.querySelectorAll("[data-ix-ba]").forEach(function(root){
var r=root.querySelector(".ix-ba-range"),st=root.querySelector(".ix-ba-stage"),bl=root.dataset.bl||"Before",down=false,moved=false;
function set(v){v=Math.max(0,Math.min(100,Math.round(v)));r.value=v;root.style.setProperty("--pos",v+"%");r.setAttribute("aria-valuetext",v+"% "+bl);}
function at(e){var b=st.getBoundingClientRect();set((e.clientX-b.left)/b.width*100);}
r.addEventListener("input",function(){set(+r.value);});
st.addEventListener("pointerdown",function(e){if(e.button>0)return;down=true;moved=false;st.setPointerCapture(e.pointerId);if(e.pointerType==="mouse"){at(e);e.preventDefault();}r.focus({preventScroll:true});});
st.addEventListener("pointermove",function(e){if(down){moved=true;at(e);}});
st.addEventListener("pointerup",function(e){if(down&&!moved)at(e);down=false;});st.addEventListener("pointercancel",function(){down=false;});
set(+r.value);root.classList.add("on");});`;
const NOJS = `.ix-ba-stage{display:grid!important;grid-template-columns:1fr 1fr;gap:.75rem;aspect-ratio:auto!important;cursor:auto!important}.ix-ba-before,.ix-ba-after{position:relative!important;clip-path:none!important;aspect-ratio:var(--ratio)}.ix-ba-before{order:-1}.ix-ba-handle,.ix-ba-range{display:none!important}`;
---
{ok && (
  <Section bg={d.background} id={d.anchor}>
    <div class="wrap ix-cq">
      <Heading eyebrow={d.eyebrow} heading={d.heading} text={d.text} />
      <figure class="ix-ba" data-ix-ba data-bl={bl} style={`--pos:${start}%;--ratio:${ratio}`}>
        <div class="ix-ba-stage">
          <div class="ix-ba-after"><Img id={after} cover sizes="(min-width: 1200px) 1184px, 100vw" widths={[480, 768, 1024, 1280, 1920]} /><span class="ix-ba-label r">{al}</span></div>
          <div class="ix-ba-before"><Img id={before} cover sizes="(min-width: 1200px) 1184px, 100vw" widths={[480, 768, 1024, 1280, 1920]} /><span class="ix-ba-label l">{bl}</span></div>
          <input class="ix-ba-range" type="range" min="0" max="100" step="1" value={start} id={`${id}-r`} aria-label={`${bl} and ${al}: move to compare`} aria-valuetext={`${start}% ${bl}`} />
          <div class="ix-ba-handle" aria-hidden="true"><span><svg viewBox="0 0 24 24"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5" /></svg></span></div>
        </div>
        {d.caption && <figcaption>{d.caption}</figcaption>}
      </figure>
    </div>
    {first && <Fragment set:html={`<noscript><style>${NOJS}</style></noscript>`} />}
    {first && <script is:inline type="module" set:html={JS} />}
  </Section>
)}
<style>
  .ix-ba { margin: 0; }
  .ix-ba-stage { position: relative; aspect-ratio: var(--ratio); border-radius: var(--radius); overflow: hidden; background: var(--paper); touch-action: pan-y; cursor: ew-resize; user-select: none; -webkit-user-select: none; }
  .ix-ba-after, .ix-ba-before { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; }
  .ix-ba-before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ix-ba-stage :global(picture), .ix-ba-stage :global(img) { width: 100%; height: 100%; pointer-events: none; -webkit-user-drag: none; }
  .ix-ba-label {
    position: absolute; top: .75rem; padding: .25rem .65rem; border-radius: 999px; background: rgba(10, 20, 26, .72); color: #fff;
    font: 700 .72rem/1.4 var(--font-body); letter-spacing: .08em; text-transform: uppercase;
  }
  .ix-ba-label.l { left: .75rem; }
  .ix-ba-label.r { right: .75rem; }
  .ix-ba-handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 0; pointer-events: none; }
  .ix-ba-handle::before { content: ""; position: absolute; top: 0; bottom: 0; left: -1px; width: 2px; background: #fff; box-shadow: 0 0 0 1px rgba(0, 0, 0, .15); }
  .ix-ba-handle span { position: absolute; top: 50%; left: 0; width: 44px; height: 44px; transform: translate(-50%, -50%); display: grid; place-items: center; border-radius: 999px; background: #fff; color: #0a141a; box-shadow: 0 2px 10px rgba(0, 0, 0, .25); }
  .ix-ba-handle svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ix-ba-range { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; opacity: 0; }
  .ix-ba-range:focus-visible + .ix-ba-handle span { outline: 3px solid var(--focus); outline-offset: 3px; }
  figcaption { margin-top: .75rem; font-size: .9rem; color: var(--muted); }
</style>
