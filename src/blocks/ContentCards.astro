---
// Content cards (Talentum's "Content cards" block): cards for any content type — Insights posts, Services, Case
// studies, Jobs, Landing pages or the site's own types (Events, Locations…). Order, filters, layout (cards in 2/3/4
// columns, a list with the image beside the text, or a compact list of titles), what each card shows, an empty
// message, and paging: with "Show all" + a number per page, pages 2, 3… are their own addresses (<page>/page/2/),
// built by [...path].astro. Columns follow the width the block has (container queries), so it works inside containers.
// `bare` = no section band (the custom-type listing page, [ct].astro, uses it inside its own).
import Section from "../components/Section.astro";
import Heading from "../components/Heading.astro";
import Buttons from "../components/Buttons.astro";
import Img from "../components/Img.astro";
import { allEntries, cardEntries, cardsPage, pagedCards, category, parentOf, parentPage, formatDate, lineName, plain, truncate, absolute, t, type Block, type Entry } from "../lib/content";

const { block, entry, first = false, bare = false, base = "" } = Astro.props as { block: Block; entry?: Entry; first?: boolean; bare?: boolean; base?: string };
const raw = block.data || {};
const ct = parentOf(raw.content_type);
// Parent pages: a block set to "Parent page's design" (and the list a parent page gets automatically) uses its Card design.
const pc = raw.design === "parent" && ct?.card ? ct.card : null;
const d: Record<string, any> = pc ? { ...raw, layout: pc.layout, columns: pc.columns, show_image: pc.show_image, show_excerpt: pc.show_excerpt, show_date: pc.show_date,
  fields: pc.fields || [], read_more: pc.read_more || raw.read_more || "" } : raw;
const ratio = ["16/10", "16/9", "4/3", "3/2", "1/1", "3/4"].includes(pc?.image_ratio || d.image_ratio) ? (pc?.image_ratio || d.image_ratio) : "16/10";
const style = ["plain", "overlay"].includes(pc?.style || d.card_style) ? (pc?.style || d.card_style) : "card";
const showCat = !!(pc ? pc.show_category : d.show_category);
const all = cardEntries(d, entry?.id);
// A filter bar shows every item on one page and filters them in the browser (no JavaScript: everything shows).
const per = d.all && !d.filter_bar ? Number(d.per_page) || 0 : 0;
// Only the page's own paged block (pagedCards) has /page/2/… addresses; `base` = a listing page that pages itself ([ct].astro).
// Any other paged block shows its first page, with "View all" to the type's listing page when there is one.
const pageBase = base || (entry && pagedCards(entry.blocks)?.id === block.id ? entry.path : "");
const pages = per && pageBase ? Math.max(1, Math.ceil(all.length / per)) : 1;
const page = pages > 1 ? Math.min(cardsPage(block.id), pages) : 1;
const list = pages > 1 ? all.slice((page - 1) * per, page * per) : per ? all.slice(0, per) : all;
const listing = parentPage(d.content_type)?.path || (ct && ct.archive && ct.route ? "/" + ct.route + "/" : "");
const viewAll = !pageBase && per && all.length > per && listing && entry?.path !== listing ? listing : "";
// A number whose address is already another page of the site isn't built for this list: no link to it.
const takenNo = (n: number) => n > 1 && allEntries.some((x) => x.path === `${pageBase}page/${n}/`);
// Back / Next go to the nearest page of this list that was built.
let prevNo = page - 1; while (prevNo > 1 && takenNo(prevNo)) prevNo--;
let nextNo = page + 1; while (nextNo <= pages && takenNo(nextNo)) nextNo++;
const layout = ["list", "compact"].includes(d.layout) ? d.layout : "grid";
const cols = ["2", "3", "4"].includes(String(d.columns)) ? Number(d.columns) : 3;
const showImage = d.show_image !== false && layout !== "compact";
const showExcerpt = d.show_excerpt !== false && layout !== "compact";
const showDate = d.show_date !== false;
const dateKey = ct ? String(d.date_field || ct.fields.find((f) => f.type === "date")?.key || "") : "";
const dateOf = (e: Entry) => String((ct && dateKey ? e.fields?.[dateKey] : e.published_at) || "");
const shownFields = ct ? ct.fields.filter((f) => (d.fields || []).includes(f.key) && f.type !== "image" && f.key !== (showDate ? dateKey : "")) : [];
const fieldText = (type: string, v: any) => (type === "date" ? formatDate(String(v)) : type === "bool" ? (v === true || v === "true" ? "Yes" : "") : type === "link" ? String(v).replace(/^entry:.*/, "").replace(/^https?:\/\//, "").replace(/\/$/, "") : String(v ?? ""));
const catNames = (e: Entry) => (e.categories || []).map((id) => category(id)?.name).filter(Boolean).join(", ");
const metaOf = (e: Entry) => [
  showCat ? catNames(e) : d.content_type === "post" ? category(e.categories?.[0])?.name : "",
  d.content_type === "service" || d.content_type === "case_study" ? lineName(e.service_line) : "",
  d.content_type === "job" ? e.fields?.location : "",
].filter(Boolean).join(" · ");
const anyImage = showImage && list.some((e) => e.featured_image);
// The filter bar: the categories the listed items have, in the site's category order.
const barCats = d.filter_bar ? Array.from(new Set(list.flatMap((e) => e.categories || []))).map((id) => category(id)).filter(Boolean) as { id: string; name: string }[] : [];
const overlay = style === "overlay" && layout === "grid" && anyImage;
const sizes = layout === "list" ? "(min-width: 760px) 280px, 100vw" : `(min-width: 1200px) ${Math.round(1180 / cols)}px, (min-width: 720px) 50vw, 100vw`;
const T = d.heading && !first ? "h3" : "h2";
const pageHref = (n: number) => (pageBase ? (n <= 1 ? pageBase : `${pageBase}page/${n}/`) : "#");
// Structured data: the list of pages shown (ItemList), so search engines see the collection.
const schema = list.length ? JSON.stringify({ "@context": "https://schema.org", "@type": "ItemList", ...(d.heading ? { name: plain(d.heading) } : {}),
  itemListElement: list.map((e, i) => ({ "@type": "ListItem", position: (page - 1) * (per || 0) + i + 1, url: absolute(e.path), name: e.title })) }).replace(/</g, "\\u003c") : "";
const Wrap: any = bare ? "div" : Section;
---
<Wrap {...(bare ? {} : { bg: d.background, id: d.anchor })}>
  <div class={bare ? "" : "wrap"}>
    {!bare && <Heading eyebrow={d.eyebrow} heading={d.heading} text={d.text} level={first ? 1 : 2} />}
    {list.length > 0 ? (
      <div class="cc-box">
        {barCats.length > 1 && (
          <div class="cc-bar" role="group" aria-label={t("filter")} data-cc-bar hidden>
            <button type="button" aria-pressed="true" data-cat="">{ct?.filter?.all_label || t("all")}</button>
            {barCats.map((c) => <button type="button" aria-pressed="false" data-cat={c.id}>{c.name}</button>)}
          </div>
        )}
        <ul class={`cc cc-${layout} cc-c${cols}${overlay ? " cc-overlay" : ""}${style === "plain" ? " cc-plain" : ""}`} role="list">
          {list.map((e) => {
            const date = showDate ? dateOf(e) : "";
            const meta = metaOf(e);
            const rows = shownFields.map((f) => ({ f, v: fieldText(f.type, e.fields?.[f.key]) })).filter((x) => x.v);
            return (
              <li class={`cc-item${layout === "compact" || style === "plain" ? "" : " card"}`} data-cats={(e.categories || []).join(" ")}>
                {anyImage && (e.featured_image
                  ? <div class="cc-img"><Img id={e.featured_image} cover aspect={ratio} sizes={sizes} widths={[360, 560, 720]} /></div>
                  : <div class="cc-img cc-ph" aria-hidden="true" style={`aspect-ratio:${ratio}`} />)}
                <div class="cc-body">
                  {(date || meta) && <p class="cc-meta">{meta}{meta && date ? " · " : ""}{date && <time datetime={date.slice(0, 10)}>{formatDate(date)}</time>}</p>}
                  <T class="cc-t"><a href={e.path}>{e.title}</a></T>
                  {showExcerpt && e.excerpt && <p class="cc-x">{truncate(plain(e.excerpt), 170)}</p>}
                  {rows.length > 0 && (
                    <dl class="cc-f">{rows.map(({ f, v }) => <div><dt>{f.label}</dt><dd>{v}</dd></div>)}</dl>
                  )}
                  {d.read_more && layout !== "compact" && <span class="cc-more" aria-hidden="true">{d.read_more} →</span>}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    ) : <p class="cc-empty">{d.empty || t("nothing_here")}</p>}
    {pages > 1 && (
      <nav class="cc-pages" aria-label={`${d.heading ? plain(d.heading) + ": " : ""}pages`}>
        {page > 1 ? <a href={pageHref(prevNo)} rel="prev">← {t("form_back")}</a> : <span aria-hidden="true" />}
        <ol role="list">
          {Array.from({ length: pages }, (_, i) => i + 1).map((n) => (
            <li>{n === page ? <span aria-current="page">{n}</span> : takenNo(n) ? <span class="cc-off">{n}</span> : <a href={pageHref(n)} aria-label={`Page ${n}`}>{n}</a>}</li>
          ))}
        </ol>
        {nextNo <= pages ? <a href={pageHref(nextNo)} rel="next">{t("form_next")} →</a> : <span aria-hidden="true" />}
      </nav>
    )}
    {viewAll && <p class="cc-all"><a href={viewAll}>{t("view_all")} →</a></p>}
    {!bare && <Buttons buttons={d.buttons} />}
  </div>
  {schema && <script type="application/ld+json" set:html={schema} />}
</Wrap>
<script>
  // Content cards filter bar (parent pages' categories): shown once JavaScript runs; hides cards outside the picked category.
  for (const bar of document.querySelectorAll<HTMLElement>("[data-cc-bar]")) {
    const list = bar.nextElementSibling as HTMLElement | null;
    if (!list) continue;
    bar.hidden = false;
    bar.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("button[data-cat]");
      if (!btn) return;
      const cat = btn.dataset.cat || "";
      for (const b of bar.querySelectorAll("button")) b.setAttribute("aria-pressed", String(b === btn));
      for (const li of list.querySelectorAll<HTMLElement>(":scope > li")) li.hidden = !!cat && !(li.dataset.cats || "").split(" ").includes(cat);
    });
  }
</script>
<style>
  .cc-box { container-type: inline-size; }
  .cc { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap); }
  .cc-item { position: relative; min-width: 0; }
  .cc-t { font-size: 1.15rem; line-height: 1.3; margin: 0; }
  .cc-t a { color: var(--heading); text-decoration: none; }
  .cc-t a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .cc-t a:focus-visible { outline: none; }
  .cc-item:has(.cc-t a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .cc-item:hover .cc-t a { color: var(--accent-text); }
  .cc-meta { font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--accent-text); margin: 0 0 .4rem; }
  .cc-x { font-size: .95rem; color: var(--muted); margin: .5rem 0 0; }
  .cc-f { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; margin: .75rem 0 0; font-size: .88rem; }
  .cc-f dt { display: inline; font-weight: 700; color: var(--muted); }
  .cc-f dt::after { content: ": "; }
  .cc-f dd { display: inline; margin: 0; color: var(--heading); }
  .cc-more { display: inline-block; margin-top: .9rem; font-weight: 600; font-size: .88rem; color: var(--accent-text); }
  .cc-img { overflow: hidden; border-radius: calc(var(--radius) - 2px); background: var(--paper); }
  .cc-ph { aspect-ratio: 16/10; }
  :global(.bg-dark) .cc-ph, :global(.bg-brand) .cc-ph { background: var(--line); }
  .cc-empty { color: var(--muted); }
  .cc-all { margin: 1.25rem 0 0; font-weight: 600; }
  .cc-all a { color: var(--accent-text); }

  /* Cards: 1 column, then 2, then the chosen number as the block gets wider. */
  .cc-grid .cc-item { display: flex; flex-direction: column; }
  .cc-grid .cc-img { margin: 0 0 1.1rem; }
  .cc-grid .cc-body { display: flex; flex-direction: column; flex: 1; }
  .cc-grid .cc-more { margin-top: auto; padding-top: .9rem; }
  @container (min-width: 34rem) { .cc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @container (min-width: 52rem) { .cc-grid.cc-c3, .cc-grid.cc-c4 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @container (min-width: 64rem) { .cc-grid.cc-c4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  /* List: the image beside the text once there's room. */
  .cc-list { gap: calc(var(--gap) * .75); }
  .cc-list .cc-img { margin-bottom: 1rem; }
  @container (min-width: 36rem) {
    .cc-list .cc-item { display: grid; grid-template-columns: minmax(10rem, 17.5rem) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
    .cc-list .cc-item:not(:has(.cc-img)) { grid-template-columns: minmax(0, 1fr); }
    .cc-list .cc-img { margin: 0; }
  }

  /* Compact: titles (and the date) in a ruled list. */
  .cc-compact { gap: 0; border-top: 1px solid var(--line); }
  .cc-compact .cc-item { padding: .9rem 0; border-bottom: 1px solid var(--line); }
  .cc-compact .cc-t { font-size: 1.05rem; }
  .cc-compact .cc-meta { margin: 0 0 .15rem; }
  .cc-compact .cc-f { margin-top: .3rem; }
  @container (min-width: 40rem) {
    .cc-compact .cc-body { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 1.5rem; align-items: baseline; }
    .cc-compact .cc-meta { grid-column: 2; grid-row: 1; margin: 0; text-align: right; }
    .cc-compact .cc-t { grid-column: 1; grid-row: 1; }
    .cc-compact .cc-f { grid-column: 1 / -1; }
  }

  .cc-item[hidden] { display: none !important; }
  .cc-bar { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 1.5rem; }
  .cc-bar[hidden] { display: none; }
  .cc-bar button { min-height: 2.5rem; padding: 0 1rem; border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--heading); font: inherit; font-weight: 600; font-size: .9rem; cursor: pointer; }
  .cc-bar button:hover { border-color: var(--accent); color: var(--accent-text); }
  .cc-bar button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent, #fff); }

  /* Card styles (a parent page's Card design): plain = no box; overlay = the title over the picture. */
  .cc-plain .cc-item { padding: 0; }
  .cc-overlay .cc-item { padding: 0; overflow: hidden; border-radius: var(--radius); display: block; }
  .cc-overlay .cc-img { margin: 0 !important; border-radius: 0; }
  .cc-overlay .cc-ph { background: var(--heading); }
  .cc-overlay .cc-body { position: absolute; inset: auto 0 0 0; padding: 1.25rem; background: linear-gradient(to top, rgba(0,0,0,.82), rgba(0,0,0,.35) 70%, transparent); color: #fff; }
  .cc-overlay .cc-t a, .cc-overlay .cc-meta, .cc-overlay .cc-more, .cc-overlay .cc-f dd { color: #fff; }
  .cc-overlay .cc-x, .cc-overlay .cc-f dt { color: rgba(255,255,255,.85); }
  .cc-overlay .cc-item:hover .cc-t a { color: #fff; text-decoration: underline; }

  .cc-pages { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2.5rem; flex-wrap: wrap; }
  .cc-pages ol { list-style: none; display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; padding: 0; }
  .cc-pages a, .cc-pages span[aria-current], .cc-pages .cc-off { display: inline-flex; align-items: center; justify-content: center; min-width: 2.75rem; min-height: 2.75rem; padding: 0 .75rem;
    border: 1px solid var(--line); border-radius: var(--radius); font-weight: 600; text-decoration: none; color: var(--heading); }
  .cc-pages .cc-off { border-color: transparent; color: var(--muted); }
  .cc-pages a:hover { border-color: var(--accent); color: var(--accent-text); }
  .cc-pages span[aria-current] { background: var(--accent); border-color: var(--accent); color: var(--on-accent, #fff); }
</style>
