---
// Image (or video poster) beside a heading, rich text and buttons. Image left or right.
import Section from "../components/Section.astro";
import Img from "../components/Img.astro";
import Buttons from "../components/Buttons.astro";
import { rich, media, type Block } from "../lib/content";
const { block } = Astro.props as { block: Block };
const d = block.data || {};
const side = d.image_side === "right" ? "right" : "left";
const hasImg = !!media(d.image);
---
<Section bg={d.background} id={d.anchor}>
  <div class={`wrap mt ${hasImg ? "has-img" : ""} img-${side}`}>
    {hasImg && <div class="media"><Img id={d.image} sizes="(min-width: 1000px) 520px, 100vw" widths={[480, 720, 1040]} /></div>}
    <div class="copy">
      {d.eyebrow && <p class="eyebrow">{d.eyebrow}</p>}
      {d.heading && <h2>{d.heading}</h2>}
      <div class="prose" set:html={rich(d.html || d.text)} />
      <Buttons buttons={d.buttons} />
    </div>
  </div>
</Section>
<style>
  .mt { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 900px) {
    .mt.has-img { grid-template-columns: var(--b-cols, minmax(0, 5fr) minmax(0, 7fr)); }
    .mt.has-img.img-right { grid-template-columns: var(--b-cols, minmax(0, 7fr) minmax(0, 5fr)); }
    .img-right .media { order: 2; }
  }
  .mt:not(.has-img) .copy { display: grid; gap: 0 clamp(2rem, 5vw, 4rem); }
  @media (min-width: 900px) { .mt:not(.has-img) .copy { grid-template-columns: var(--b-cols, 5fr 7fr); } .mt:not(.has-img) .copy > h2, .mt:not(.has-img) .copy > .eyebrow { grid-column: 1; } .mt:not(.has-img) .copy > .prose, .mt:not(.has-img) .copy > .btns { grid-column: 2; } .mt:not(.has-img) .copy > .prose { grid-row: 1 / span 3; } }
  .media :global(img) { width: 100%; border-radius: var(--radius); }
  .prose { color: var(--muted); font-size: 1.05rem; }
  .prose :global(strong) { color: var(--heading); }
</style>
