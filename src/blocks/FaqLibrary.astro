---
// Question library: every FAQ in the site's library (or one service line's), grouped into topics, with a search box.
// All questions and answers are in the HTML and in the page's FAQPage data, so this is the page that does the
// heavy lifting for search. Each answer ends with a link to talk to someone.
import Section from "../components/Section.astro";
import Heading from "../components/Heading.astro";
import Icon from "../components/next/Icon.astro";
import { rich, href, settings, type Block, type Entry } from "../lib/content";
import { libraryFaqs } from "../lib/faqlib";
const { block, entry, first = false } = Astro.props as { block: Block; entry?: Entry; first?: boolean };
const d = block.data || {};
const faqs = libraryFaqs(d, entry);
const groups = [...new Set(faqs.map((f) => f.group || d.other_label || "General"))];
const cta = settings.header_cta || {};
const ask = { label: d.ask_label || "Ask us in a 15-minute call", href: href(d.ask_href || cta.url || "") };
const id = "fl-" + block.id;
---
{faqs.length > 0 && (
  <Section bg={d.background || "white"} id={d.anchor} class="fl">
    <div class="wrap">
      <Heading eyebrow={d.eyebrow} heading={d.heading || (first ? entry?.title : undefined)} text={d.text} level={first ? 1 : 2} />
      <div class="fl-tools" data-fl={id}>
        <label class="fl-q"><Icon name="search" size={20} /><span class="sr-only">Search the questions</span>
          <input type="search" placeholder={d.search_placeholder || "Search, e.g. cost, website, LinkedIn"} autocomplete="off" /></label>
        {groups.length > 1 && (
          <div class="fl-topics" role="group" aria-label="Topics">
            <button type="button" data-g="" aria-pressed="true">All <span>{faqs.length}</span></button>
            {groups.map((g) => <button type="button" data-g={g} aria-pressed="false">{g} <span>{faqs.filter((f) => (f.group || d.other_label || "General") === g).length}</span></button>)}
          </div>
        )}
      </div>
      <div class="fl-list" id={id}>
        {faqs.map((f, i) => (
          <details class="fl-item" data-g={f.group || d.other_label || "General"} open={i === 0 && d.open_first !== false ? true : undefined}>
            <summary><span>{f.question}</span><span class="fl-sign" aria-hidden="true"></span></summary>
            <div class="fl-a">
              <div class="prose" set:html={rich(f.answer)} />
              {ask.label && <p class="fl-ask"><a href={ask.href}>{ask.label}</a></p>}
            </div>
          </details>
        ))}
        <p class="fl-none" hidden>Nothing matches that yet. {ask.label && <a href={ask.href}>Ask us directly</a>}</p>
      </div>
    </div>
  </Section>
)}
<script is:inline>
document.querySelectorAll("[data-fl]").forEach((tools) => {
  const list = document.getElementById(tools.dataset.fl); if (!list) return;
  const q = tools.querySelector("input"), items = [...list.querySelectorAll(".fl-item")], none = list.querySelector(".fl-none");
  let g = "";
  const norm = (t) => t.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
  const run = () => {
    const words = norm(q.value).split(/\s+/).filter(Boolean); let shown = 0;
    items.forEach((it) => { const ok = (!g || it.dataset.g === g) && words.every((w) => norm(it.textContent).includes(w)); it.hidden = !ok; if (ok) shown++; });
    none.hidden = shown > 0;
  };
  q.addEventListener("input", run);
  tools.querySelectorAll("[data-g]").forEach((b) => b.addEventListener("click", () => { g = b.dataset.g; tools.querySelectorAll("[data-g]").forEach((x) => x.setAttribute("aria-pressed", String(x === b))); run(); }));
});
</script>
<style>
  .fl-tools { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1rem; max-width: 52rem; }
  .fl-q { display: flex; align-items: center; gap: .75rem; height: 56px; padding: 0 1rem; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); color: var(--muted); background: var(--surface); }
  .fl-q input { flex: 1; min-width: 0; height: 100%; border: 0; outline: 0; background: transparent; font: 500 1.05rem var(--font-body); color: var(--heading); }
  .fl-q:focus-within { box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus) 45%, transparent); }
  .fl-topics { display: flex; flex-wrap: wrap; gap: .4rem; }
  .fl-topics button { display: inline-flex; align-items: center; gap: .45rem; min-height: 40px; padding: 0 .9rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: transparent; color: var(--text); font: 600 .9rem var(--font-body); cursor: pointer; }
  .fl-topics button span { font: 500 .72rem var(--font-mono, monospace); color: var(--muted); }
  .fl-topics button[aria-pressed="true"] { background: var(--heading); border-color: var(--heading); color: var(--bg, #fff); }
  html[data-bg="image"] .fl-topics button[aria-pressed="true"] { color: #0a141a; }
  .fl-topics button[aria-pressed="true"] span { color: inherit; opacity: .7; }
  .fl-list { max-width: 52rem; }
  .fl-item { border-bottom: 1px solid var(--line); }
  .fl-item summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.15rem 0; cursor: pointer; font: 700 1.08rem/1.4 var(--font-body); color: var(--heading); }
  .fl-item summary::-webkit-details-marker { display: none; }
  .fl-item summary:hover > span:first-child { color: var(--accent-text); }
  .fl-sign { position: relative; width: 14px; height: 14px; flex-shrink: 0; }
  .fl-sign::before, .fl-sign::after { content: ""; position: absolute; left: 0; right: 0; top: 6px; height: 2px; background: var(--accent-text); }
  .fl-sign::after { transform: rotate(90deg); transition: transform .2s ease; }
  .fl-item[open] .fl-sign::after { transform: rotate(0deg); }
  .fl-a { padding: 0 0 1.4rem; }
  .fl-a .prose { color: var(--text); }
  .fl-ask { margin: .75rem 0 0; font-weight: 700; font-size: .95rem; }
  .fl-none { margin-top: 1.5rem; }
</style>
