---
// FAQ — picked questions, a group, or the service line's. Two columns of open Q&A (default) or an accordion.
import Section from "../components/Section.astro";
import Heading from "../components/Heading.astro";
import { resolveFaqs, rich, type Block, type Entry } from "../lib/content";
const { block, entry } = Astro.props as { block: Block; entry?: Entry };
const d = block.data || {};
const list = resolveFaqs(d, entry);
const accordion = d.layout === "accordion";
---
{list.length > 0 && (
  <Section bg={d.background} id={d.anchor || "faq"}>
    <div class="wrap">
      <Heading eyebrow={d.eyebrow} heading={d.heading || "Frequently asked questions"} text={d.text} />
      {accordion ? (
        <div class="acc">
          {list.map((f) => <details><summary><h3>{f.question}</h3></summary><div class="prose" set:html={rich(f.answer)} /></details>)}
        </div>
      ) : (
        <dl class="grid cols-2 qa">
          {list.map((f) => <div class="rule-top"><dt><h3>{f.question}</h3></dt><dd class="prose" set:html={rich(f.answer)} /></div>)}
        </dl>
      )}
    </div>
  </Section>
)}
<style>
  .qa { margin: 0; max-width: 54rem; gap: 2rem 1.5rem; }
  .qa .rule-top { border-top-color: var(--line); }
  dd { margin: 0; font-size: .95rem; color: var(--muted); }
  h3 { font-size: 1.1rem; margin: 0 0 .6rem; }
  .acc { max-width: 52rem; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; padding: 1.1rem 2.5rem 1.1rem 0; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; }
  summary::after { content: "+"; position: absolute; right: .25rem; top: 50%; transform: translateY(-50%); font-size: 1.5rem; color: var(--accent-text); }
  details[open] summary::after { content: "–"; }
  details .prose { padding-bottom: 1.25rem; color: var(--muted); }
</style>
