---
import Section from "../components/Section.astro";
import Heading from "../components/Heading.astro";
import Img from "../components/Img.astro";
import { media, type Block } from "../lib/content";
const { block } = Astro.props as { block: Block };
const d = block.data || {};
const logos = (d.logos || []).filter((id: string) => media(id));
---
<Section bg={d.background || "dark"} id={d.anchor} tight={!d.heading}>
  <div class="wrap center">
    <Heading eyebrow={d.eyebrow} heading={d.heading} text={d.text} center />
    {logos.length > 0 && <ul class="logos">{logos.map((id: string) => <li><Img id={id} sizes="160px" widths={[160, 320]} /></li>)}</ul>}
  </div>
</Section>
<style>
  .logos { list-style: none; margin: 2rem 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: clamp(1.5rem, 4vw, 3rem); }
  .logos :global(img) { height: 40px; width: auto; filter: grayscale(1); opacity: .8; }
  :global(.bg-dark) .logos :global(img) { filter: grayscale(1) brightness(2.2); }
</style>
