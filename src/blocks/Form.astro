---
// Contact form. Submissions go to the site's form endpoint (the Cloudflare Worker → Talentum Requests, phase 8).
// Until that's switched on, the form shows the site's email and phone instead, so nothing is ever lost.
import Section from "../components/Section.astro";
import Heading from "../components/Heading.astro";
import { settings, type Block } from "../lib/content";
const { block } = Astro.props as { block: Block };
const d = block.data || {};
const endpoint: string = settings.forms?.endpoint || "";
const key = d.form_key || "contact";
const o = settings.org || {};
const fields = (d.fields?.length ? d.fields : [
  { name: "name", label: "Name", type: "text", required: true },
  { name: "email", label: "Work email", type: "email", required: true },
  { name: "company", label: "Company", type: "text" },
  { name: "phone", label: "Phone", type: "tel" },
  { name: "message", label: "How can we help?", type: "textarea", required: true },
]) as { name: string; label: string; type: string; required?: boolean; options?: string[] }[];
const ac: Record<string, string> = { name: "name", email: "email", company: "organization", phone: "tel" };
---
<Section bg={d.background} id={d.anchor || "contact"}>
  <div class="wrap form-wrap">
    <Heading eyebrow={d.eyebrow} heading={d.heading} text={d.text} />
    {endpoint ? (
      <form class="card form" method="post" action={`${endpoint.replace(/\/+$/, "")}/${key}`} data-form={key}>
        {fields.map((f) => (
          <label class={f.type === "textarea" ? "full" : ""}>
            <span>{f.label}{f.required && <em aria-hidden="true"> *</em>}</span>
            {f.type === "textarea" ? <textarea name={f.name} rows="5" required={f.required} /> :
              f.type === "select" ? <select name={f.name} required={f.required}><option value="">Choose…</option>{(f.options || []).map((o) => <option>{o}</option>)}</select> :
              <input name={f.name} type={(f.type || "text") as any} required={f.required} autocomplete={(ac[f.name] || "on") as any} />}
          </label>
        ))}
        <input type="text" name="_hp" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <input type="hidden" name="_page" value={Astro.url.pathname} />
        <div class="full"><button class="btn btn-primary" type="submit">{d.submit_label || "Send"}</button></div>
        <p class="full ok" hidden role="status">{d.success || "Thanks — we'll be in touch shortly."}</p>
        <p class="full bad" hidden role="alert">Sorry — that didn't send. Please try again{o.email ? <> or email <a href={`mailto:${o.email}`}>{o.email}</a></> : null}.</p>
      </form>
    ) : (
      <div class="card alt">
        <p>{d.fallback || "The fastest way to reach us:"}</p>
        <ul>
          {o.email && <li><a href={`mailto:${o.email}`}>{o.email}</a></li>}
          {o.phone && <li><a href={`tel:${o.phone.replace(/[^\d+]/g, "")}`}>{o.phone}</a></li>}
        </ul>
      </div>
    )}
  </div>
</Section>
{endpoint && (
  <script is:inline>
    document.querySelectorAll("form[data-form]").forEach((f) => f.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = f.querySelector("button[type=submit]"); btn.disabled = true;
      const data = Object.fromEntries(new FormData(f));
      try { const p = new URLSearchParams(location.search); ["utm_source","utm_medium","utm_campaign","utm_term","utm_content","gclid","fbclid"].forEach((k) => { if (p.get(k)) data[k] = p.get(k); }); data._referrer = document.referrer; } catch (x) {}
      try {
        const r = await fetch(f.action, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) });
        if (!r.ok) throw new Error(String(r.status));
        f.querySelectorAll("label, .full:not(.ok)").forEach((x) => x.remove()); f.querySelector(".ok").hidden = false;
        window.gtag && gtag("event", "generate_lead", { form: f.dataset.form });
      } catch (x) { btn.disabled = false; f.querySelector(".bad").hidden = false; }
    }));
  </script>
)}
<style>
  .form-wrap { max-width: 52rem; }
  .form { display: grid; gap: 1rem 1.25rem; }
  @media (min-width: 720px) { .form { grid-template-columns: 1fr 1fr; } .full { grid-column: 1 / -1; } }
  label span { display: block; font-weight: 600; font-size: .9rem; color: var(--heading); margin-bottom: .35rem; }
  label em { color: var(--accent-text); font-style: normal; }
  input, textarea, select { width: 100%; font: inherit; font-size: 1rem; padding: .7rem .8rem; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); background: var(--surface); color: var(--text); }
  input:focus, textarea:focus, select:focus { outline: 2px solid var(--focus); outline-offset: 1px; border-color: transparent; }
  .bad { color: #b42318; font-weight: 600; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .alt ul { list-style: none; padding: 0; margin: 0; font-size: 1.15rem; font-weight: 600; }
  .alt li + li { margin-top: .4rem; }
</style>
