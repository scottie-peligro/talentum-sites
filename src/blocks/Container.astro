---
// Container: a band (or inset card) with its own background (colour, gradient, image or looping video) holding other
// blocks, in 1–4 columns. Blocks inside drop their own background and most of their padding so they sit on this one.
// Video backgrounds are muted, loop, never autoplay for reduced-motion or data-saver visitors (they get the poster).
import Img from "../components/Img.astro";
import Blocks from "../components/Blocks.astro";
import { media, type Block, type Entry } from "../lib/content";
import { assetUrl } from "../lib/images";
const { block, entry, first = false } = Astro.props as { block: Block; entry?: Entry; first?: boolean };
const d = block.data || {};
const hex = (v: any, fb = "") => (typeof v === "string" && /^#[0-9a-f]{6}$/i.test(v) ? v : fb);
const num = (v: any, lo: number, hi: number, fb: number) => { const n = Number(v); return Number.isFinite(n) && n >= lo && n <= hi ? n : fb; };

const cols = (Array.isArray(d.cols) ? d.cols : []).slice(0, 4).map((c: any) => (Array.isArray(c?.blocks) ? c.blocks : []));
const n = Math.max(1, cols.length);
const RATIOS: Record<string, string> = { "50-50": "1fr 1fr", "40-60": "2fr 3fr", "60-40": "3fr 2fr", "33-67": "1fr 2fr", "67-33": "2fr 1fr", "25-75": "1fr 3fr", "75-25": "3fr 1fr", "even": "" };
const template = n === 2 && RATIOS[d.ratio] ? RATIOS[d.ratio] : `repeat(${n}, minmax(0, 1fr))`;

const type = ["color", "gradient", "image", "video"].includes(d.bg_type) ? d.bg_type : "none";
let bg = "";
if (type === "color") bg = hex(d.bg_color, "#f1f2f2");
if (type === "gradient") {
  const stops = [hex(d.g_from, "#025a8a"), hex(d.g_via), hex(d.g_to, "#011e2f")].filter(Boolean).join(", ");
  bg = d.g_kind === "radial" ? `radial-gradient(circle at ${d.g_pos || "50% 50%"}, ${stops})` : `linear-gradient(${num(d.g_angle, 0, 360, 135)}deg, ${stops})`;
}
const img = type === "image" ? media(d.bg_image) : undefined;
const vid = type === "video" ? media(d.bg_video) : undefined;
const vidUrl = vid ? assetUrl(vid.file) : "";
const poster = media(d.bg_poster);
const posterUrl = poster ? assetUrl(poster.file) : "";
const overlay = (type === "image" || type === "video") ? `${hex(d.overlay_color, "#011e2f")}${Math.round(num(d.overlay, 0, 95, 55) * 2.55).toString(16).padStart(2, "0")}` : "";

const tone = d.tone === "dark" || d.tone === "light" ? d.tone : (type === "image" || type === "video" ? "dark" : "light");
const PAD: Record<string, string> = { none: "0", s: "clamp(1.5rem, 3vw, 2.5rem)", m: "clamp(2.5rem, 5vw, 4.5rem)", l: "clamp(4rem, 8vw, 7rem)", xl: "clamp(6rem, 12vw, 10rem)" };
const pad = PAD[d.padding] || PAD.m;
const WIDTH: Record<string, string> = { reading: "46rem", normal: "var(--max)", wide: "96rem", full: "100%" };
const inner = WIDTH[d.inner_width] || WIDTH.normal;
const MINH: Record<string, string> = { none: "0", s: "20rem", m: "32rem", l: "44rem", screen: "min(100dvh, 60rem)" };
const minH = MINH[d.min_height] || "0";
const RAD: Record<string, string> = { none: "0", soft: "var(--radius)", round: "24px" };
const card = d.shape === "card";
const radius = card ? (RAD[d.radius] || "var(--radius)") : "0";
const valign = { top: "start", center: "center", bottom: "end" }[d.valign as string] || "center";
const style = [`--ct-pad:${pad}`, `--ct-inner:${inner}`, `--ct-minh:${minH}`, `--ct-rad:${radius}`, `--ct-cols:${template}`, `--ct-v:${valign}`, bg ? `--ct-bg:${bg}` : "", overlay ? `--ct-ov:${overlay}` : ""].filter(Boolean).join(";");
---
<section class={`ct ct-${tone}${card ? " ct-card" : ""}`} id={d.anchor || undefined} style={style}>
  {img && <div class="ct-media" aria-hidden="true"><Img id={d.bg_image} alt="" cover sizes="100vw" widths={[640, 960, 1280, 1920, 2560]} /></div>}
  {vidUrl && (
    <div class="ct-media" aria-hidden="true">
      {posterUrl && <img class="ct-poster" src={posterUrl} alt="" loading="lazy" />}
      <video class="ct-video" data-src={vidUrl} muted loop playsinline preload="none" poster={posterUrl || undefined}></video>
    </div>
  )}
  {overlay && <div class="ct-ov" aria-hidden="true"></div>}
  <div class="ct-in">
    <div class="ct-grid">
      {cols.map((list: Block[], ci: number) => <div class="ct-col"><Blocks blocks={list} entry={entry} depth={first && ci === 0 ? 0 : 1} /></div>)}
    </div>
  </div>
</section>
{vidUrl && (
  <script is:inline>
  (function(){
    var still = matchMedia("(prefers-reduced-motion: reduce)").matches || (navigator.connection && navigator.connection.saveData);
    document.querySelectorAll("video.ct-video[data-src]").forEach(function(v){
      if (still) return;
      var io = new IntersectionObserver(function(es){ es.forEach(function(en){
        if (en.isIntersecting) { if (!v.src) { v.src = v.dataset.src; } v.play().catch(function(){}); v.classList.add("on"); } else { v.pause(); }
      }); }, { rootMargin: "200px" });
      io.observe(v);
    });
  })();
  </script>
)}
<style>
  .ct { position: relative; isolation: isolate; overflow: hidden; background: var(--ct-bg, transparent); padding-block: var(--ct-pad); min-height: var(--ct-minh); display: grid; align-items: var(--ct-v); }
  .ct-card { width: min(100% - 2 * var(--gutter), var(--max)); margin: clamp(1.5rem, 4vw, 3rem) auto; border-radius: var(--ct-rad); }
  .ct-media, .ct-ov { position: absolute; inset: 0; z-index: -1; }
  .ct-media :global(img), .ct-media :global(picture), .ct-video, .ct-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ct-video { opacity: 0; transition: opacity .6s; }
  .ct-video.on { opacity: 1; }
  .ct-ov { background: var(--ct-ov); }
  .ct-in { width: min(100% - 2 * var(--gutter), var(--ct-inner)); margin-inline: auto; }
  .ct-grid { display: grid; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  @media (min-width: 900px) { .ct-grid { grid-template-columns: var(--ct-cols); } }
  .ct-dark { --surface: var(--dark-card); --paper: var(--dark-card); color: var(--on-dark); --heading: var(--on-dark-heading); --text: var(--on-dark); --muted: var(--on-dark-muted); --line: var(--on-dark-line); --link: var(--on-dark-heading); --link-hover: var(--on-dark-heading); }
  /* Blocks inside sit on the container: no own background, less padding, full column width. */
  .ct-col :global(.section), .ct-col :global(.hero) { background: transparent !important; color: inherit; padding-block: clamp(.75rem, 2vw, 1.5rem) !important;
    --heading: inherit; --text: inherit; --muted: inherit; --line: inherit; --link: inherit; --link-hover: inherit; }
  .ct-col :global(.wrap), .ct-col :global(.wrap.narrow) { width: 100%; }
  .ct-col :global(.hero .bgimg) { display: none; }
  .ct-col > :global(:first-child) :global(.section) { padding-top: 0 !important; }
</style>
