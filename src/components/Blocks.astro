---
// Renders a list of blocks. `section_ref` pulls in a global section (Website → Navigation & sections).
import Hero from "../blocks/Hero.astro";
import Steps from "../blocks/Steps.astro";
import RichText from "../blocks/RichText.astro";
import ImageBlock from "../blocks/ImageBlock.astro";
import Gallery from "../blocks/Gallery.astro";
import Video from "../blocks/Video.astro";
import MediaText from "../blocks/MediaText.astro";
import ServiceGroups from "../blocks/ServiceGroups.astro";
import ServiceCards from "../blocks/ServiceCards.astro";
import LogoStrip from "../blocks/LogoStrip.astro";
import StatBand from "../blocks/StatBand.astro";
import Results from "../blocks/Results.astro";
import CaseStudyCards from "../blocks/CaseStudyCards.astro";
import CaseStudyStory from "../blocks/CaseStudyStory.astro";
import Testimonials from "../blocks/Testimonials.astro";
import TeamGrid from "../blocks/TeamGrid.astro";
import PostsList from "../blocks/PostsList.astro";
import Faq from "../blocks/Faq.astro";
import Cta from "../blocks/Cta.astro";
import Form from "../blocks/Form.astro";
import Comparison from "../blocks/Comparison.astro";
import JobsList from "../blocks/JobsList.astro";
import DataBlock from "../blocks/DataBlock.astro";
import Pricing from "../blocks/Pricing.astro";
import Misc from "../blocks/Misc.astro";
import IntentChooser from "../blocks/IntentChooser.astro";
import StartingPoints from "../blocks/StartingPoints.astro";
import IconSteps from "../blocks/IconSteps.astro";
import FaqLibrary from "../blocks/FaqLibrary.astro";
import Booking from "../blocks/Booking.astro";
import BookCard from "../blocks/BookCard.astro";
import Container from "../blocks/Container.astro";
import { INTERACTIVE } from "../blocks/interactive/index";
import { settings, site, section, currentLang, t, type Block, type Entry } from "../lib/content";

// depth = how many global sections deep (section_ref), so a section can't pull itself in forever. lead = this list
// starts the page (the first block gets `first`: its heading is the H1); a container passes it to its first column.
const { blocks = [], entry, depth = 0, grouped = false, offset = 0, lead } = Astro.props as { blocks?: Block[]; entry?: Entry; depth?: number; grouped?: boolean; offset?: number; lead?: boolean };
const leads = lead ?? depth === 0;
const C: Record<string, any> = {
  hero: Hero, steps: Steps, rich_text: RichText, image: ImageBlock, gallery: Gallery, video: Video, media_text: MediaText,
  service_groups: ServiceGroups, service_cards: ServiceCards, logo_strip: LogoStrip, stat_band: StatBand, results: Results,
  case_study_cards: CaseStudyCards, case_study_story: CaseStudyStory, testimonials: Testimonials, team_grid: TeamGrid,
  posts_list: PostsList, faq: Faq, cta: Cta, form: Form, comparison: Comparison, jobs_list: JobsList,
  map: Misc, html: Misc, spacer: Misc, contact_details: Misc, data: DataBlock, pricing: Pricing, intent_chooser: IntentChooser, starting_points: StartingPoints, icon_steps: IconSteps, faq_library: FaqLibrary, booking: Booking, book_card: BookCard, container: Container,
  ...INTERACTIVE,
};
const shown = blocks.filter((b) => b && !b.hidden);
// "Show under Read more": consecutive blocks with data.in_depth sit inside one <details> (still in the HTML, so
// search engines read them), opened by "Read the in-depth answer" (or the first block's own label).
type Seg = { deep: boolean; items: { b: Block; i: number }[] };
const segs: Seg[] = [];
shown.forEach((b, i) => {
  const deep = !grouped && !!b.data?.in_depth;
  const last = segs[segs.length - 1];
  if (last && last.deep === deep && deep) last.items.push({ b, i });
  else segs.push({ deep, items: [{ b, i }] });
});
const deepLabel = (s: Seg) => s.items[0].b.data?.in_depth_label || (currentLang() ? t("in_depth") : (settings.display as any)?.read_more_label || t("in_depth"));
import { blockWrap } from "../lib/blockStyle";
const liveView = !!(site as any).live;
---
{segs.map((s) => s.deep ? (
  <details class="deep">
    <summary class="deep-sum"><span class="wrap"><span class="deep-btn">{deepLabel(s)}</span></span></summary>
    <Astro.self blocks={s.items.map((x) => x.b)} entry={entry} depth={depth} grouped offset={offset + s.items[0].i} lead={leads} />
  </details>
) : s.items.map(({ b, i }) => {
  if (b.type === "section_ref") {
    const inner = depth < 2 ? section(b.data?.key) : null;
    return inner ? <Astro.self blocks={inner} entry={entry} depth={depth + 1} /> : null;
  }
  const Comp = C[b.type];
  if (!Comp) return null;
  const w = blockWrap(b.data?.style);
  const first = leads && offset + i === 0;
  const el = w ? <div class="bs" style={w.style || undefined} {...w.attrs}><Comp block={b} entry={entry} first={first} depth={depth} /></div>
    : <Comp block={b} entry={entry} first={first} depth={depth} />;
  // Live view in the editor: tag each of the page's own blocks (those inside its containers too, so a click picks the
  // innermost) so a click can open it in the editor. Blocks from a global section aren't the page's own.
  return liveView && depth === 0 && !grouped ? <div data-live-block={b.id} data-live-type={b.type} style="display:contents">{el}</div> : el;
}))}
