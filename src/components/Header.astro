---
// Site header: an optional top bar, the logo, the "header" menu (one level of dropdowns) and the header buttons.
// The mobile menu and the dropdowns are <details> elements, so they work with no JavaScript; a few lines close them
// on outside click / Esc. Styles → Header (src/lib/styles.ts headerOpts): layout (logo left + menu right, menu in the
// middle, or everything centred), sticky or not, the look (solid, a line, a shadow, see-through blur), menu text.
import Img from "./Img.astro";
import LangSwitch from "./LangSwitch.astro";
import { menu, settings, site, menuHref, href, media, localPath, t } from "../lib/content";
import { headerOpts as ho } from "../lib/styles";
const { path } = Astro.props as { path: string };
const items = menu("header");
const cta = settings.header_cta || {};
// The header buttons: the main one, then up to three more ("primary" | "secondary" | "link").
const buttons = [cta, ...(Array.isArray(cta.more) ? cta.more : [])].filter((b: any) => b && b.label)
  .map((b: any, i: number) => ({ ...b, cls: (b.style || (i === 0 ? "primary" : "secondary")) === "link" ? "hd-link" : `btn btn-${b.style || (i === 0 ? "primary" : "secondary")}` }));
const logo = (ho.lightHeader ? settings.brand?.logo : settings.brand?.logo_inverse) || settings.brand?.logo;
// The logo is served at the size it's shown (and twice that for sharp screens), whatever height is picked.
const lm = logo ? media(logo) : undefined;
const logoW = lm && lm.width && lm.height ? Math.ceil(ho.logoH * lm.width / lm.height) : 180;
const tb = ho.topbar;
const name = settings.org?.name || site.name;
const active = (h: string) => h !== "/" && h !== "#" && path.startsWith(h);
---
{tb && (tb.text || tb.phone || tb.email || tb.link_label) && (
  <div class="topbar"><div class="wrap tb-in">
    {tb.text && <span class="tb-text">{tb.text}</span>}
    <span class="tb-links">
      {tb.phone && <a href={`tel:${tb.phone.replace(/[^\d+]/g, "")}`}>{tb.phone}</a>}
      {tb.email && <a href={`mailto:${tb.email}`}>{tb.email}</a>}
      {tb.link_label && <a href={href(tb.link_url)}>{tb.link_label}</a>}
    </span>
  </div></div>
)}
<header class={`site-header hd-${ho.layout}${ho.sticky ? "" : " hd-static"}${ho.look ? " hd-" + ho.look : ""}`}>
  <div class="wrap bar">
    <a href={localPath("/")} class="brand" aria-label={`${name} — home`}>
      {logo && lm ? <Img id={logo} alt={name} class="logo" sizes={`${logoW}px`} widths={[logoW, logoW * 2]} priority /> : <span class="wordmark">{name}</span>}
    </a>
    <button class="toggle" type="button" aria-label={t("menu")} aria-expanded="false" aria-controls="site-nav"><span class="burger" aria-hidden="true"></span></button>
    <div class="mobile">
      <nav class="nav" id="site-nav" aria-label="Main">
        <ul>
          {items.map((it) => (
            <li>
              {it.children?.length ? (
                <details class="drop">
                  <summary class={active(menuHref(it)) ? "on" : ""}>{it.label}</summary>
                  <ul>
                    {it.url || it.entry ? <li><a href={menuHref(it)}>{it.label} {t("overview")}</a></li> : null}
                    {it.children.map((ch) => (
                      <li><a href={menuHref(ch)} target={ch.new_tab ? "_blank" : undefined} rel={ch.new_tab ? "noopener" : undefined}>
                        <span>{ch.label}</span>{ch.description && <small>{ch.description}</small>}</a></li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={menuHref(it)} class={active(menuHref(it)) ? "on" : ""} aria-current={path === menuHref(it) ? "page" : undefined}
                  target={it.new_tab ? "_blank" : undefined} rel={it.new_tab ? "noopener" : undefined}>{it.label}</a>
              )}
            </li>
          ))}
        </ul><LangSwitch path={path} />
        {buttons.length > 0 && (
          <div class="hd-actions">
            {buttons.map((b: any) => <a class={`${b.cls} cta`} href={href(b.url)} target={b.new_tab ? "_blank" : undefined} rel={b.new_tab ? "noopener" : undefined}>{b.label}</a>)}
          </div>
        )}
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  (() => { const h = document.currentScript.previousElementSibling, b = h && h.querySelector(".toggle"); if (b) b.addEventListener("click", () => { const o = h.classList.toggle("open"); b.setAttribute("aria-expanded", String(o)); }); })();
  document.addEventListener("click", (e) => { document.querySelectorAll(".site-header details[open]").forEach((d) => { if (!d.contains(e.target)) d.removeAttribute("open"); }); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") document.querySelectorAll(".site-header details[open]").forEach((d) => d.removeAttribute("open")); });
</script>

<style>
  .site-header { background: var(--header-bg); color: var(--header-text); position: sticky; top: 0; z-index: 50; border-bottom: 1px solid rgba(255,255,255,.06); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: var(--head-h, 72px); }
  .brand { display: inline-flex; align-items: center; color: inherit; text-decoration: none; flex-shrink: 0; }
  .brand :global(.logo), .brand :global(img) { height: var(--logo-h-m, var(--logo-h, 38px)); width: auto; max-width: 70vw; }
  @media (min-width: 900px) { .brand :global(.logo), .brand :global(img) { height: var(--logo-h, 38px); } }
  .wordmark { font: 700 1.25rem/1 var(--font-heading); }
  ul { list-style: none; margin: 0; padding: 0; }
  summary { list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .nav a, .drop > summary { color: var(--header-text); text-decoration: none; font: var(--menu-weight, 600) var(--menu-size, .9rem)/1.2 var(--font-body); text-transform: var(--menu-case, none); letter-spacing: var(--menu-track, normal); }
  .nav > ul > li > a:hover, .drop > summary:hover { color: var(--header-hover, var(--accent-text)); }
  .nav a.on, .drop > summary.on { color: var(--header-hover, var(--accent-text)); }
  .nav a.cta { text-transform: none; letter-spacing: normal; font-size: .9rem; }
  .nav a.btn-primary.cta, .nav a.btn-primary.cta:hover { color: var(--on-accent); }   /* header buttons keep their own text colour, not the menu's */
  .nav a.btn-secondary.cta { color: var(--header-text); border-color: currentColor; }
  .nav a.btn-secondary.cta:hover { background: var(--header-text); color: var(--header-bg); }
  .nav a.hd-link.cta { font-weight: 700; }
  .hd-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
  .hd-actions .cta { margin-top: 0; }
  /* Top bar */
  .topbar { background: var(--topbar-bg, var(--dark)); color: var(--topbar-text, var(--on-dark, #fff)); font-size: .82rem; }
  .tb-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .35rem 1.5rem; min-height: 2.25rem; padding-block: .35rem; }
  .tb-links { display: flex; flex-wrap: wrap; gap: .35rem 1.25rem; }
  .topbar a { color: inherit; text-decoration: none; font-weight: 600; }
  .topbar a:hover { text-decoration: underline; }
  /* Looks */
  .site-header.hd-static { position: relative; }
  .site-header.hd-line { border-bottom: 1px solid var(--line); }
  .site-header.hd-shadow { border-bottom: 0; box-shadow: 0 6px 24px rgba(5, 11, 31, .1); }
  .site-header.hd-blur { background: color-mix(in srgb, var(--header-bg) 82%, transparent); -webkit-backdrop-filter: blur(14px) saturate(1.4); backdrop-filter: blur(14px) saturate(1.4); }
  .toggle { display: grid; place-items: center; width: 44px; height: 44px; margin-right: -10px; background: none; border: 0; color: inherit; cursor: pointer; }
  .burger, .burger::before, .burger::after { display: block; width: 22px; height: 2px; background: currentColor; border-radius: 2px; position: relative; }
  .burger::before, .burger::after { content: ""; position: absolute; left: 0; }
  .burger::before { top: -7px; } .burger::after { top: 7px; }
  .site-header.open .mobile { position: absolute; left: 0; right: 0; top: 100%; background: var(--header-bg); padding: 1rem var(--gutter) 1.5rem; border-bottom: 1px solid rgba(255,255,255,.1); max-height: calc(100dvh - 72px); overflow: auto; }
  .mobile .nav > ul > li { border-bottom: 1px solid rgba(255,255,255,.08); }
  .mobile .nav > ul > li > a, .mobile .drop > summary { display: block; padding: .9rem 0; }
  .drop ul a { display: block; padding: .55rem 0 .55rem .9rem; font-weight: 500; }
  .drop small { display: block; color: var(--on-dark-muted, #9aa6bd); font-size: .8rem; font-weight: 400; margin-top: 2px; }
  .hd-actions { margin-top: 1rem; }
  @media (min-width: 1000px) {
    .toggle { display: none; }
    .mobile { display: block !important; }
    .nav { display: flex; align-items: center; gap: 1.75rem; position: static !important; padding: 0 !important; border: 0 !important; background: none !important; }
    .nav > ul { display: flex; align-items: center; gap: var(--menu-gap, 1.6rem); }
    /* Menu in the middle: logo left, menu centred, buttons right. */
    .hd-center-menu .mobile { flex: 1; }
    .hd-center-menu .nav { width: 100%; }
    .hd-center-menu .nav > ul { margin-inline: auto; }
    /* Centred: the logo on its own row, the menu and buttons centred under it. */
    .hd-centered .bar { flex-direction: column; justify-content: center; gap: .6rem; padding-block: .9rem; }
    .hd-centered .nav { justify-content: center; flex-wrap: wrap; }
    .hd-actions { margin-top: 0; }
    .mobile .nav > ul > li { border: 0; position: relative; }
    .mobile .nav > ul > li > a, .mobile .drop > summary { padding: .5rem 0; }
    .drop > summary::after { content: ""; display: inline-block; width: 6px; height: 6px; margin-left: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-3px) rotate(45deg); }
    .drop[open] > ul { position: absolute; top: calc(100% + 14px); left: -1rem; min-width: 280px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 18px 40px rgba(5, 11, 31, .18); padding: .5rem; }
    .drop[open] ul a { color: var(--heading); padding: .6rem .75rem; border-radius: var(--radius-sm); }
    .drop[open] ul a:hover { background: var(--paper); }
    .drop small { color: var(--muted); }
  }
  @media (max-width: 999px) { .site-header:not(.open) .mobile { display: none; } .mobile { position: absolute; left: 0; right: 0; top: 100%; } }
</style>
