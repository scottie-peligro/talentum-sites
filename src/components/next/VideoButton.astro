---
// "Watch the overview" — a small button by the page title (and a card in the wide-screen side rail). Nothing from the
// video host loads until it's pressed; the player opens over the page (VideoPlayer.astro). A tick shows once watched.
import Icon from "./Icon.astro";
import Img from "../Img.astro";
import { rich, t } from "../../lib/content";
import type { VideoInfo } from "../../lib/next";
const { video, variant = "pill", transcript = false } = Astro.props as { video: VideoInfo; variant?: "pill" | "card"; transcript?: boolean };
const label = video.title;
---
{variant === "pill" ? (
  <div class="ov">
    <button type="button" class="ov-btn" data-ov aria-haspopup="dialog">
      <span class="ov-ic"><Icon name="play" size={14} /></span>
      <span class="ov-t">{label}</span>
      {video.durationLabel && <span class="ov-d">{video.durationLabel}</span>}
      <span class="ov-w" title="Watched"><Icon name="check" size={14} /><span class="sr-only">(watched)</span></span>
    </button>
    {transcript && video.transcript && (
      <details class="ov-tr">
        <summary>{t("read_instead")}</summary>
        <div class="prose" set:html={rich(video.transcript)} />
      </details>
    )}
  </div>
) : (
  <button type="button" class="ov-card" data-ov aria-haspopup="dialog">
    <span class="ov-poster">
      {video.poster ? <Img id={video.poster} alt="" cover sizes="300px" widths={[300, 600]} /> : video.posterUrl ? <img src={video.posterUrl} alt="" loading="lazy" width="480" height="270" /> : <span class="ov-blank" />}
      <span class="ov-play"><Icon name="play" size={18} /></span>
    </span>
    <span class="ov-ct"><strong>{label}</strong>{video.durationLabel && <small>{video.durationLabel}</small>}<span class="ov-w ov-w2"><Icon name="check" size={12} />{" " + t("watched")}</span></span>
  </button>
)}
