{
  "name": "talentum-sites",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Static website renderer for Talentum Websites — builds each site from its published content and deploys it to Cloudflare Pages.",
  "scripts": {
    "fetch": "node scripts/fetch-content.mjs",
    "dev": "astro dev",
    "build": "node scripts/fetch-content.mjs && astro build && node scripts/postbuild.mjs",
    "build:only": "astro build && node scripts/postbuild.mjs",
    "check": "astro check",
    "builder": "node builder/server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "astro": "5.18.2",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/sanitize-html": "2.16.2",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  },
  "engines": { "node": ">=20.19" }
}
